.env.example
PHOTON_VERSION=0.7.4
PHOTON_COUNTRIES=JP,BG,HR,CZ,DE,GR,HU,IT,RO,RS,SI,SE
PHOTON_JAVA_OPTS=-Xms4g -Xmx8g
PHOTON_RUN_ARGS=-data-dir /var/lib/photon -listen-ip 0.0.0.0 -cors-any -max-results 50
PHOTON_KEEP_COMBINED_JSON=1
RETENTION_BUILDS=1
RETENTION_DUMPS=1
FORCE_REIMPORT=0
REBUILD_CRON=0 3 1 * *
PHOTON_DOMAIN=photon.domain.com
DOWNLOAD_RETRIES=5
DOWNLOAD_BACKOFF_SECONDS=5
CHECKSUM_VERIFY=1
CHECKSUM_RECORD=1
CHECKSUM_ALGO=md5
CHECKSUM_STRICT_FILENAMES=0
# CHECKSUM_SOURCE_URL=https://example.com/photon-dumps-sha256.txt
# CHECKSUM_INLINE="\
# sha256hash1  photon-dump-japan-0.7-latest.jsonl.zst\n# sha256hash2  photon-dump-germany-0.7-latest.jsonl.zst\n# "
